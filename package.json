{
  "name": "dsh-desktop",
  "version": "0.2.0",
  "description": "DeepSeek Harness Web GUI 的 Electron 桌面壳 — 拿来即用，免装 Node.js，双击打开",
  "main": "electron/main.js",
  "author": "tiankunrui",
  "license": "MIT",
  "scripts": {
    "start": "node scripts/ensure-dsh.js && electron .",
    "start:raw": "electron .",
    "ensure-dsh": "node scripts/ensure-dsh.js",
    "build:prepare": "node scripts/ensure-dsh.js",
    "dist": "npm run build:prepare && electron-builder --mac dmg zip",
    "dist:win": "npm run build:prepare && electron-builder --win nsis zip",
    "dist:all": "npm run build:prepare && electron-builder --mac dmg zip --win nsis zip"
  },
  "build": {
    "appId": "com.tkr.dsh-desktop",
    "productName": "DeepSeek Harness",
    "files": [
      "electron/**/*",
      "scripts/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/dsh",
        "to": "vendor/dsh",
        "filter": ["**/*", "!package-lock.json"]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "identity": null,
      "hardenedRuntime": false,
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] },
        { "target": "zip", "arch": ["arm64", "x64"] }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "zip", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DeepSeek Harness"
    },
    "electronDownload": {
      "cache": ".cache/electron"
    },
    "directories": {
      "output": "release"
    }
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  }
}